# ============================================================
# JUNK AWAY — ENVIRONMENT VARIABLES
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` to git.
# ============================================================

# Resend — for contact form emails. Get your key at https://resend.com
# After signing up, verify the junkawaydelaware.com domain so the "from"
# address `forms@junkawaydelaware.com` works.
RESEND_API_KEY=

# Optional: Google Sheets webhook (Apps Script doPost endpoint) for
# permanent backup logging of every form submission. Leave blank to skip.
SHEETS_WEBHOOK_URL=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Public, prefixed with NEXT_PUBLIC_ — fine to expose.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification meta tag value (just the content="..."
# value, not the whole tag). Public.
NEXT_PUBLIC_GSC_VERIFICATION=

# Cloudflare Turnstile (optional invisible bot protection on the form).
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
